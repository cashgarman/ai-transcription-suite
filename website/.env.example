# Copy to .env.local and fill in as these become available.

# Where the header and hero "free trial" buttons point.
# Defaults to the /download page when unset.
NEXT_PUBLIC_DOWNLOAD_URL=

# Direct link to the Windows installer. When set, /download shows a real
# download button instead of the "being packaged" panel.
NEXT_PUBLIC_WINDOWS_INSTALLER_URL=

# Endpoint the launch-list form POSTs {"email": "..."} to, for example a
# Formspree or Getform URL. When unset the form confirms without sending.
NEXT_PUBLIC_WAITLIST_URL=
